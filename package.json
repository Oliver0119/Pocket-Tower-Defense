    "gen:levels": "tsc -p tsconfig.sim.json && node .sim-out/tools/gen-levels.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
