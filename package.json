{
  "name": "pocket-tower-defense",
  "version": "0.1.0",
  "private": true,
  "description": "《口袋守塔》轻量塔防 - 微信小游戏（Cocos Creator 3.x + TypeScript）",
  "scripts": {
    "typecheck": "tsc -p tsconfig.sim.json --noEmit",
    "sim": "tsc -p tsconfig.sim.json && node .sim-out/tools/simulate.js",
    "tune": "tsc -p tsconfig.sim.json && node .sim-out/tools/tune.js",
    "build:web": "node tools/build-web.mjs",
    "start": "npm run build:web && node tools/serve.mjs",
    "smoke:web": "npm run build:web && node tools/smoke-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
