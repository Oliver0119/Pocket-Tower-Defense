{
  "name": "pocket-tower-defense",
  "version": "0.1.0",
  "private": true,
  "description": "《口袋守塔》轻量塔防 - 微信小游戏（Cocos Creator 3.x + TypeScript）",
  "scripts": {
    "typecheck": "tsc -p tsconfig.sim.json --noEmit",
